@startuml
title User - Login (Email & Google)

|User|
start
:Akses Halaman Login;
if (Pilih Login Email?) then (Login Email)
    :Input Email & Password;
    :Submit;
    |System|
    :Validasi Kredensial;
    if (Valid & Terverifikasi?) then (Ya)
        :Buat Sesi Login;
        :Redirect ke Dashboard;
    else (Tidak)
        :Tampilkan Pesan Error Login;
    endif
elseif (Pilih Login Google?) then (Login Google)
    |System|
    :Redirect ke Google Authentication;
    |User|
    :(Interaksi dengan Google: Autentikasi & Otorisasi);
    |Google|
    :Callback ke Sistem dengan Auth Code/Token;
    |System|
    :Validasi Token Google & Ambil Info User;
    :Cek/Buat Akun User di Sistem;
    :Buat Sesi Login;
    :Redirect ke Dashboard;
else (Pilihan Lain)
    stop
endif
stop
@enduml