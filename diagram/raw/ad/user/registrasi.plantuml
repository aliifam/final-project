@startuml
title User - Registrasi Akun (Email)

|User|
start
:Akses Halaman Registrasi;
:Mengisi Form Registrasi (Nama, Email, Password);
:Submit Form;
|Sistem|
:Validasi Data Registrasi;
if (Data Valid?) then (Ya)
    :Buat Akun User Baru (status belum terverifikasi);
    :Kirim Email Verifikasi;
    :Tampilkan Pesan Sukses & Instruksi Verifikasi;
else (Tidak)
    :Tampilkan Pesan Error Validasi;
endif
stop
@enduml