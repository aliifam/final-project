@startuml
!theme plain
top to bottom direction

title Diagram Arsitektur Deploy Aplikasi Tamu.id (Layout Ditingkatkan - Revisi Grup)

' Aktor
actor "Pengguna Aplikasi" as User
actor "Admin" as AdminUser

' Internet sebagai media akses dan koneksi ke layanan eksternal
cloud "Internet" as Internet

' Infrastruktur Frontend di Cloudflare
node "Cloudflare" as CloudflarePlatform {
    node "Cloudflare Pages" as CFPages {
        artifact "Frontend Pengguna Tamu.id" as UserFE
        artifact "Frontend Admin Tamu.id" as AdminFE
    }
    note right of CFPages
        Menyajikan Frontend (Static Hosting).
        Menyediakan CDN untuk aset frontend.
    end note
}

' Infrastruktur Backend, Database, dan Storage di Google Cloud Platform (GCP)
cloud "Google Cloud Platform (GCP)" as GCP {
    node "Google Cloud Run" as CloudRunService {
        artifact "Backend API Tamu.id" as BackendAPI
        note as BackendApiNote
            Logika bisnis, integrasi layanan,
            database, & manajemen akses GCS.
        end note
        BackendAPI .. BackendApiNote
    }
    node "Google Cloud SQL" as CloudSQLInstance {
        database "PostgreSQL Database Tamu.id" as PostgresDB
    }
    storage "Google Cloud Storage (GCS)" as GCS {
        note top of GCS
            Penyimpanan file & aset:
            KYC, Avatar, Gambar Pod,
            Fasilitas, Voucher, dll.
        end note
    }
}

' Layanan Eksternal (dikelompokkan untuk kerapian)
package "Layanan Eksternal via Internet" { 
    node "Google OAuth Server" as GoogleOAuthServer
    node "Midtrans API Server" as MidtransAPIServer
}

node "Perangkat IoT Tamu.id\n(di setiap Pod)" as IoTDevice


' === Alur Utama Aplikasi ===
User -up-> Internet
AdminUser -up-> Internet
Internet -down-> CFPages : Akses HTTPS ke Frontend

CFPages -down-> UserFE
CFPages -down-> AdminFE

' Interaksi Frontend dengan Backend
UserFE -down-> Internet : Permintaan API (JSON)
AdminFE -down-> Internet : Permintaan API (JSON)
Internet -down-> BackendAPI : (Endpoint HTTPS Cloud Run)

' Interaksi Backend dengan GCP Services
BackendAPI -down-> PostgresDB : Koneksi Database
BackendAPI -- GCS : Upload/Download File, \nGenerate URL Akses

' Interaksi Frontend untuk mengakses Aset dari GCS
UserFE .down.> Internet : Permintaan Aset GCS (via URL)
AdminFE .down.> Internet : Permintaan Aset GCS (via URL)
Internet .down.> GCS : Ambil Aset dari GCS


' === Integrasi dengan Layanan Eksternal ===

' 1. Google OAuth
UserFE <-left- GoogleOAuthServer : Alur Auth OAuth2 (Redirect Browser)
BackendAPI <-up- GoogleOAuthServer : Validasi Kode & Ambil Token/Info

' 2. Midtrans
BackendAPI <-up- MidtransAPIServer : Buat Transaksi QRIS & Terima Webhook

' 3. Perangkat IoT
BackendAPI <-down- IoTDevice : Sinkronisasi Data QR, Perintah, Log

@enduml