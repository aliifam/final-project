% Pengaturan untuk daftar kode
\renewcommand{\lstlistingname}{Kode} % Mengubah nama default 'Listing' menjadi 'Kode'

% Bahasa TypeScript
\lstdefinelanguage{TypeScript}{
    keywords={function, return, let, const, var, if, else, for, while, switch, case, break, default, true, false, null, undefined, class, extends, implements, interface, public, private, protected, static, readonly, as, async, await},
    keywordstyle=\color{blue}\bfseries,
    identifierstyle=\color{black},
    sensitive=true,
    comment=[l]{//},
    morecomment=[s]{/*}{*/},
    commentstyle=\color{gray}\itshape,
    stringstyle=\color{orange},
    morestring=[b]',
    morestring=[b]"
}

% Bahasa TSX
\lstdefinelanguage{TSX}[]{TypeScript}{
    morekeywords={jsx, render, React, Component, PropTypes},
    morecomment=[s]{/**}{*/}
}

% Bahasa JavaScript
\lstdefinelanguage{JavaScript}{
    keywords={function, return, let, const, var, if, else, for, while, switch, case, break, default, true, false, null, undefined, class, extends, try, catch, finally, throw, import, export, from, as, async, await, new},
    keywordstyle=\color{blue}\bfseries,
    identifierstyle=\color{black},
    sensitive=true,
    comment=[l]{//},
    morecomment=[s]{/*}{*/},
    commentstyle=\color{gray}\itshape,
    stringstyle=\color{orange},
    morestring=[b]',
    morestring=[b]"
}

% Bahasa Vue (template + script hybrid)
\lstdefinelanguage{Vue}[]{HTML}{
    morekeywords={data, methods, computed, mounted, created, setup, template, script, style, defineComponent, ref, reactive, watch, defineProps, defineEmits, v-if, v-for, v-model, v-bind, v-on},
    keywordstyle=\color{blue}\bfseries,
    morecomment=[s]{<!--}{-->}, % HTML-style comments
    commentstyle=\color{gray}\itshape,
    morestring=[b]',
    morestring=[b]",
    stringstyle=\color{orange},
    alsoletter={:},
    moredelim=**[is][\color{gray}]{<template>}{</template>},
    moredelim=**[is][\color{gray}]{<script>}{</script>},
    moredelim=**[is][\color{gray}]{<style>}{</style>},
    sensitive=true
}

% Bahasa Python
\lstdefinelanguage{Python}{
    keywords={def, return, if, elif, else, for, while, break, continue, in, not, and, or, is, import, from, as, pass, class, try, except, finally, raise, with, lambda, True, False, None, async, await, yield},
    keywordstyle=\color{blue}\bfseries,
    sensitive=true,
    comment=[l]{\#},
    morestring=[b]',
    morestring=[b]",
    stringstyle=\color{orange},
    commentstyle=\color{gray}\itshape
}

% Bahasa JSON
\lstdefinelanguage{JSON}{
    basicstyle=\ttfamily\scriptsize,
    showstringspaces=false,
    morestring=[b]",
    stringstyle=\color{orange},
    literate=
     *{0}{{{\color{blue}0}}}{1}
      {1}{{{\color{blue}1}}}{1}
      {2}{{{\color{blue}2}}}{1}
      {3}{{{\color{blue}3}}}{1}
      {4}{{{\color{blue}4}}}{1}
      {5}{{{\color{blue}5}}}{1}
      {6}{{{\color{blue}6}}}{1}
      {7}{{{\color{blue}7}}}{1}
      {8}{{{\color{blue}8}}}{1}
      {9}{{{\color{blue}9}}}{1}
      {:}{{{\color{black}:}}}{1}
      {,}{{{\color{black},}}}{1}
      {\{}{{{\color{black}\{}}}{1}
      {\}}{{{\color{black}\}}}}{1}
      {[}{{{\color{black}[}}}{1}
      {]}{{{\color{black}]}}}{1},
}

