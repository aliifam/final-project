	backgroundcolor=\color{gray!10},
    numbers=left,
    numberstyle=\tiny,
    stepnumber=1,
    numbersep=5pt,
    breaklines=true,
    showspaces=false,
    showstringspaces=false,
    frame=single,
    captionpos=b, % Caption di bawah
    escapeinside={(*@}{@*)}, % Abaikan parsing karakter tertentu
}


